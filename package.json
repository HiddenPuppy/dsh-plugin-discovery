{
  "name": "dsh-plugin-discovery",
  "version": "1.4.0",
  "private": true,
  "description": "插件发现：在 DSH 侧边栏浏览 GitHub 上的 DSH 插件市场全量目录（2.2 万+ 插件），含中文简介、分类筛选、排序与每次打开自动刷新",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-plugin-market",
    "plugin-discovery",
    "cordis-plugin"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "zh-descriptions.json",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "author": {
    "name": "HiddenPuppy",
    "url": "https://github.com/HiddenPuppy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiddenPuppy/dsh-plugin-discovery.git"
  },
  "homepage": "https://github.com/HiddenPuppy/dsh-plugin-discovery#readme",
  "bugs": {
    "url": "https://github.com/HiddenPuppy/dsh-plugin-discovery/issues"
  }
}
